<%- include('partials/header') %>

<main class="project-details-container">
    <h1><%= project.title %></h1>
    
    <div class="project-info">
        <p><strong>Description:</strong> <%= project.description %></p>
        
        <% 
            const dateOptions = { year: 'numeric', month: 'long', day: 'numeric' };
            const formattedDate = new Date(project.date).toLocaleDateString('en-US', dateOptions);
        %>
        <p><strong>Date:</strong> <%= formattedDate %></p>
        <p><strong>Location:</strong> <%= project.location %></p>
        
        <p><strong>Partner Organization:</strong> 
            <!-- Link to the organization details page -->
            <a href="/organization/<%= project.organization_id %>">
                <%= project.organization_name %>
            </a>
        </p>
    </div>
    <div class="project-categories">
        <h3>Categories:</h3>
        <% if (categories && categories.length > 0) { %>
            <div class="tags-container">
                <% categories.forEach(category => { %>
                    <a href="/category/<%= category.category_id %>" class="category-tag">
                        <%= category.name %>
                    </a>
                <% }) %>
            </div>
        <% } else { %>
            <p>No categories assigned to this project.</p>
        <% } %>
    </div>
</main>

<%- include('partials/footer') %>
