<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>
    <ul>
        <% if (categories && categories.length > 0) { %>
            <% categories.forEach(category => { %>
                <li>
                    <%= category.name %>
                </li>
            <% }) %>
        <% } else { %>
            <p>No categories found.</p>
        <% } %>
    </ul>
</main>

<%- include('partials/footer') %>
