<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
    <p>Here are a few of our partner organizations:</p>
    
    <ul>
        <% organizations.forEach(organization => { %>
            <li>
                <img src="/images/<%= organization.logo_filename %>" alt="<%= organization.name %> logo" style="display:block; margin-bottom:10px;">
                <strong><a href="/organization/<%= organization.organization_id %>"><%= organization.name %></a></strong>
                <p><%= organization.description %></p>
                <p>Contact: <%= organization.contact_email %></p>
            </li>
        <% }); %>
    </ul>
    <% if (user && user.role_name === 'admin') { %>
        <p><a href="/new-organization">Add a new organization</a></p>
    <% } %>
</main>
<%- include('partials/footer') %>
